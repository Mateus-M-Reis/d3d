-- Per-instance material tint. The pbr material exposes base_color as a user
-- constant, so each cube can have its own colour without duplicating shaders.

function init(self)
    go.set("#ground", "base_color", vmath.vector4(0.38, 0.40, 0.44, 1))
    go.set("#cube1", "base_color", vmath.vector4(0.85, 0.22, 0.18, 1))
    go.set("#cube2", "base_color", vmath.vector4(0.20, 0.65, 0.32, 1))
    go.set("#cube3", "base_color", vmath.vector4(0.18, 0.42, 0.88, 1))
    go.set("#cube4", "base_color", vmath.vector4(0.90, 0.62, 0.15, 1))
    go.set("#cube5", "base_color", vmath.vector4(0.65, 0.28, 0.78, 1))
end
