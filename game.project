[project]
title = d3d
version = 0.1.0
developer = d3d

[library]
include_dirs = d3d

[bootstrap]
main_collection = /example/main.collectionc
render = /d3d/d3d.renderc

[display]
width = 1280
height = 720
high_dpi = 1

[input]
game_binding = /builtins/input/all.input_bindingc
repeat_interval = 0.05

[physics]
type = 3D
gravity_y = -9.8

[light]
max_count = 32

[script]
shared_state = 1

[shader]
output_spirv = 1

[render]
clear_color_red = 0.05
clear_color_green = 0.06
clear_color_blue = 0.08
clear_color_alpha = 1.0

[d3d]
camera = main:/camera#camera
hdr = 1
shadows = 1
cascades = 3
shadow_resolution = 2048
shadow_lambda = 0.75
shadow_bias = 0.004
shadow_slope_bias = 0.008
exposure = 1.0
fog_density = 0.012
fog_red = 0.55
fog_green = 0.65
fog_blue = 0.8
clear_red = 0.05
clear_green = 0.06
clear_blue = 0.08

[html5]
show_fullscreen_button = 0
show_made_with_defold = 0
scale_mode = fit
