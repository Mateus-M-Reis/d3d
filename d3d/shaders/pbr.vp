#version 140

// d3d PBR vertex shader.
//
// World position, normal, UVs, view depth and the three cascade coordinates
// are passed to the fragment stage. Shadow coordinates stay homogeneous until
// the fragment shader so the perspective divide happens after interpolation.

in highp vec4 position;
in mediump vec2 texcoord0;
in mediump vec3 normal;

in highp mat4 mtx_world;
in highp mat4 mtx_normal;

uniform d3d_vertex
{
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
    highp mat4 mtx_shadow0;
    highp mat4 mtx_shadow1;
    highp mat4 mtx_shadow2;
};

out highp vec3 var_world_position;
out highp vec3 var_view_position;
out mediump vec3 var_normal;
out mediump vec2 var_texcoord0;
out highp vec4 var_shadow0;
out highp vec4 var_shadow1;
out highp vec4 var_shadow2;

void main()
{
    highp vec4 world_position = mtx_world * vec4(position.xyz, 1.0);
    highp vec4 view_position = mtx_view * world_position;

    var_world_position = world_position.xyz;
    var_view_position = view_position.xyz;
    var_normal = (mtx_normal * vec4(normal, 0.0)).xyz;
    var_texcoord0 = texcoord0;

    var_shadow0 = mtx_shadow0 * world_position;
    var_shadow1 = mtx_shadow1 * world_position;
    var_shadow2 = mtx_shadow2 * world_position;

    gl_Position = mtx_proj * view_position;
}
