#version 140

// Depth-only vertex shader used when the render script overrides every caster
// material with the d3d shadow-depth material.

in highp vec4 position;

in highp mat4 mtx_world;

uniform d3d_shadow_vertex
{
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
};

void main()
{
    gl_Position = mtx_proj * mtx_view * mtx_world * vec4(position.xyz, 1.0);
}
