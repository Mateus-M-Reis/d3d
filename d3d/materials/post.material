name: "d3d_post"
tags: "d3d_post"
vertex_program: "/d3d/shaders/fullscreen.vp"
fragment_program: "/d3d/shaders/post.fp"
vertex_space: VERTEX_SPACE_LOCAL

fragment_constants {
  name: "post_params"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 2.2
    w: 0.12
  }
}

samplers {
  name: "scene_texture"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
max_page_count: 0
